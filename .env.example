# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local tidak pernah di-commit ke Git.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Webhook WhatsApp. Buat nilai acak: npm run webhook:tokens
# URL webhook: https://<domain>/api/webhooks/whatsapp/<WHATSAPP_WEBHOOK_PATH_TOKEN>
WHATSAPP_WEBHOOK_PATH_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Kosongkan selama memakai Dualhook (signature memakai secret mereka).
WHATSAPP_APP_SECRET=

# Diisi di sprint berikutnya
# WHATSAPP_ACCESS_TOKEN=
# META_ADS_ACCESS_TOKEN=
# CRON_SECRET=
