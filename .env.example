# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local tidak pernah di-commit ke Git.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Webhook WhatsApp. Buat nilai acak: npm run webhook:tokens
# URL webhook: https://<domain>/api/webhooks/whatsapp/<WHATSAPP_WEBHOOK_PATH_TOKEN>
WHATSAPP_WEBHOOK_PATH_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# App secret app Meta "Connectiv" (App settings → Basic).
WHATSAPP_APP_SECRET=
# URL terpisah untuk nomor lewat Dualhook (tanpa verifikasi signature):
# https://<domain>/api/webhooks/whatsapp/<WHATSAPP_DUALHOOK_PATH_TOKEN>
WHATSAPP_DUALHOOK_PATH_TOKEN=
WHATSAPP_DUALHOOK_VERIFY_TOKEN=

# Meta Ads: token system user (Business Manager Delegativ) dengan ads_read
META_ADS_ACCESS_TOKEN=
# META_GRAPH_VERSION=v27.0
# Rahasia untuk Vercel Cron (npm run webhook:tokens juga membuatnya)
CRON_SECRET=

# Unduh media chat (gambar, voice note, video, dokumen) ke Supabase Storage.
# Nomor lewat Dualhook: API key per koneksi (Dualhook → Connection → Overview →
# Outbound API key), dipisah koma: <phone_number_id>:dh_live_...,<id>:dh_live_...
DUALHOOK_API_KEYS=
# Nomor lewat app Meta sendiri / Tech Provider: token system user
# (izin whatsapp_business_messaging).
WHATSAPP_ACCESS_TOKEN=
